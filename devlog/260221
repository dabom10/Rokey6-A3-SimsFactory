from pxr import UsdGeom
import numpy as np

def get_world_pos(stage, path):
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        print(f"❌ {path} 없음")
        return None
    t = UsdGeom.Xformable(prim).ComputeLocalToWorldTransform(0).ExtractTranslation()
    return np.array([t[0], t[1], t[2]])

