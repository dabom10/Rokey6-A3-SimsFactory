### 6-7. Pick & Place 메인 시퀀스 (그리퍼 미장착 버전)

```python
async def pick_and_place():
    stage = omni.usd.get_context().get_stage()
    if check_graph_active(stage):
        return

    timeline = omni.timeline.get_timeline_interface()
    if not timeline.is_playing():
        timeline.play()
        await settle(30)

    ctrl = dc.acquire_dynamic_control_interface()
    art  = ctrl.get_articulation("/Root/run_robot/body")
    if art == dc.INVALID_HANDLE:
        print("[Error] Play 상태 확인!")
        return

    cube_pos = get_world_pos(stage, "/BlackGrid/Grid_Cubes/Cube_04")
    base_pos = get_world_pos(stage, "/Root/run_robot/ur10/base_link")
    dist     = np.linalg.norm(cube_pos - base_pos)

    if dist > L_UPPER + L_FORE:
        print(f"[Error] 거리({dist:.2f}m) > 최대도달({L_UPPER+L_FORE:.2f}m)")
        return

    pre_pick  = compute_ik(cube_pos, base_pos, z_offset=0.20)
    pick      = compute_ik(cube_pos, base_pos, z_offset=0.03)
    place_pos = cube_pos + np.array([0.0, -2.0, 0.0])
    pre_place = compute_ik(place_pos, base_pos, z_offset=0.20)
    place_j   = compute_ik(place_pos, base_pos, z_offset=0.03)

    print("[1/7] 홈 자세")
    await lerp_to(ctrl, art, HOME); await settle()

    print("[2/7] Pre-Pick 접근")
    await lerp_to(ctrl, art, pre_pick); await settle(60)

    print("[3/7] Pick 하강")
    await lerp_to(ctrl, art, pick, steps=80); await settle(60)

    print("[4/7] 흡착")
    # gripper_ctrl(stage, True)  ← 그리퍼 장착 후 주석 해제
    await settle(40)

    print("[5/7] 들어올리기")
    await lerp_to(ctrl, art, pre_pick, steps=80); await settle(30)

    print("[6/7] Place 이동 & 하강")
    await lerp_to(ctrl, art, pre_place); await settle(60)
    await lerp_to(ctrl, art, place_j, steps=80); await settle(60)

    print("[7/7] 해제 & 홈 복귀")
    # gripper_ctrl(stage, False)  ← 그리퍼 장착 후 주석 해제
    await lerp_to(ctrl, art, pre_place, steps=80); await settle(30)
    await lerp_to(ctrl, art, HOME); await settle()
    print("✅ 완료!")

asyncio.ensure_future(pick_and_place())
```

