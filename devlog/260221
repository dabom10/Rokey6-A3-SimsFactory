```python
import omni.client, os
from pxr import Usd, UsdGeom, UsdPhysics, Gf

SCALE    = 2.5679999946747207
SAVE_DIR = "/home/rokey/Documents/ur10_scaled"
S3_BASE  = "https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.0/Isaac/Robots/UniversalRobots/ur10"

# 1. S3 다운로드
