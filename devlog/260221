                  "configuration/ur10_physics.usd",
                  "configuration/ur10_robot_schema.usd",
                  "configuration/ur10_sensor.usd"]:
    src = f"{S3_BASE}/{usd_file}"
    dst = os.path.join(SAVE_DIR, usd_file)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    result, _, content = omni.client.read_file(src)
    if result == omni.client.Result.OK:
        with open(dst, "wb") as f:
            f.write(memoryview(content).tobytes())

# 2. ur10_base.usd 링크 translate × SCALE
base_stage = Usd.Stage.Open(f"{SAVE_DIR}/configuration/ur10_base.usd")
for prim in base_stage.TraverseAll():
    if not prim.IsA(UsdGeom.Xformable): continue
    for op in UsdGeom.Xformable(prim).GetOrderedXformOps():
        if "translate" in op.GetOpName().lower():
            val = op.Get()
            if val and any(abs(v) > 0.0001 for v in val):
                op.Set(Gf.Vec3d(val[0]*SCALE, val[1]*SCALE, val[2]*SCALE))
base_stage.GetRootLayer().Save()

# 3. ur10_physics.usd joint localPos0/1 × SCALE
phys_stage = Usd.Stage.Open(f"{SAVE_DIR}/configuration/ur10_physics.usd")
for prim in phys_stage.TraverseAll():
    for attr_name in ["physics:localPos0", "physics:localPos1"]:
        attr = prim.GetAttribute(attr_name)
        if attr and attr.Get():
            val = attr.Get()
            if any(abs(v) > 0.0001 for v in val):
                attr.Set(Gf.Vec3f(val[0]*SCALE, val[1]*SCALE, val[2]*SCALE))
phys_stage.GetRootLayer().Save()

# 4. ur10.usd S3 경로 → 로컬 상대경로 텍스트 치환
