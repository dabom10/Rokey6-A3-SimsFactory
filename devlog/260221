for fname in ["ur10_robot_schema.usd", "ur10_base.usd",
              "ur10_physics.usd", "ur10_sensor.usd"]:
    content = content.replace(
        f"{S3_BASE}/configuration/{fname}",
        f"./configuration/{fname}"
    )
with open(f"{SAVE_DIR}/ur10.usd", "w") as f:
